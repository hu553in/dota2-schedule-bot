{
  "name": "d2-schedule-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Telegram bot for Dota 2 schedules, live matches, results, tournament seasons, and favorites.",
  "homepage": "https://t.me/d2_schedule_bot",
  "license": "MIT",
  "author": "Ruslan Khasanshin",
  "repository": "https://github.com/hu553in/dota2-schedule-bot",
  "type": "module",
  "scripts": {
    "build": "wrangler deploy --dry-run",
    "dev": "node scripts/dev.ts",
    "lint": "ultracite check",
    "lint:fix": "ultracite fix",
    "check:hooks": "lefthook validate",
    "check:workflows": "bunx github-actionlint",
    "check:renovate": "bunx --package renovate renovate-config-validator --strict --no-global renovate.json",
    "check:types": "wrangler types --env-file .dev.vars.example && tsc --pretty -p tsconfig.test.json",
    "check:unused": "knip",
    "check:vulns": "bun audit --prod --audit-level=high",
    "test": "vitest run",
    "test:coverage": "bun run test --coverage",
    "check": "bun lint && bun check:hooks && bun check:workflows && bun check:renovate && bun check:types && bun run build && bun check:unused && bun check:vulns && bun test:coverage",
    "check:fix": "bun lint:fix && bun check",
    "deploy": "node scripts/deploy.ts",
    "prepare": "if [ -n \"${CI:-}\" ] || [ \"${LEFTHOOK:-}\" = \"0\" ]; then exit 0; fi; lefthook install"
  },
  "dependencies": {
    "@grammyjs/parse-mode": "^2.3.0",
    "@grammyjs/stateless-question": "^4.0.0",
    "grammy": "^1.45.1",
    "i18next": "^26.3.6",
    "ky": "^2.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.20.3",
    "@types/node": "^22.20.1",
    "@vitest/coverage-istanbul": "^4.1.10",
    "knip": "^6.32.0",
    "lefthook": "^2.1.10",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "typescript": "^7.0.2",
    "ultracite": "^7.10.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.120.0"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "bun@1.4.0"
}

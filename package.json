{
  "name": "d2-schedule-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Telegram bot for Dota 2 schedules, live matches, results, tournament seasons, and favorites.",
  "homepage": "https://t.me/d2_schedule_bot",
  "license": "MIT",
  "author": "Ruslan Khasanshin",
  "repository": "https://github.com/hu553in/dota2-schedule-bot",
  "type": "module",
  "scripts": {
    "build": "wrangler deploy --dry-run",
    "dev": "node scripts/dev.ts",
    "lint": "ultracite check",
    "lint:fix": "ultracite fix",
    "check:hooks": "lefthook validate",
    "check:workflows": "bunx --minimum-release-age 259200 github-actionlint",
    "check:types": "wrangler types --env-file .dev.vars.example && bun check",
    "check:unused": "knip",
    "check:vulns": "bun audit --prod --audit-level=high",
    "test": "vitest run",
    "test:coverage": "bun run test --coverage",
    "check:all": "bun lint && bun check:hooks && bun check:workflows && bun check:types && bun run build && bun check:unused && bun check:vulns && bun test:coverage",
    "check:fix": "bun lint:fix && bun check:all",
    "deploy": "node scripts/deploy.ts",
    "prepare": "if [ -n \"${CI:-}\" ] || [ \"${LEFTHOOK:-}\" = \"0\" ]; then exit 0; fi; lefthook install"
  },
  "dependencies": {
    "@grammyjs/parse-mode": "^2.3.0",
    "@grammyjs/stateless-question": "^4.0.0",
    "grammy": "^1.46.0",
    "i18next": "^27.2.2",
    "ky": "^2.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.8.5",
    "@types/node": "^22.20.5",
    "@vitest/coverage-istanbul": "^5.1.1",
    "knip": "^6.47.0",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "typescript": "^7.0.2",
    "ultracite": "^8.3.1",
    "vitest": "^5.1.1",
    "wrangler": "^4.165.0"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "bun@1.4.5"
}
